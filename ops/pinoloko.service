[Unit]
Description=Pinoloko — sesión nocturna autónoma de Claude Code
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=idarroniz
WorkingDirectory=/home/idarroniz/pinoloko
ExecStart=/home/idarroniz/pinoloko/scripts/noche.sh

# La ventana de 5 h del plan es RODANTE: arranca con la primera petición. Si la
# sesión pasa de 5 h abre una segunda ventana que se solapa con la mañana de
# Ismael. Por eso el corte va a 4h50m: 00:15 -> 05:05, dentro de una sola ventana.
TimeoutStartSec=4h50m

# La Pi comparte sitio con Immich y el stack de Velltec: la sesión nocturna
# cede CPU y disco, y tiene techo de memoria.
Nice=10
IOSchedulingClass=idle
CPUWeight=30
MemoryHigh=1800M
MemoryMax=2400M

Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=CHROMIUM_PATH=/usr/bin/chromium
Environment=PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
Environment=PINOLOKO_MAX_TURNS=2500
Environment=PINOLOKO_MODEL=claude-fable-5-1
# Ismael trabaja en Opus: el cupo semanal de Fable es casi todo para la sesión
# nocturna, pero el cupo "all models" sí es compartido y se guarda con más celo.
Environment=PINOLOKO_TOPE_COMPARTIDO=60
Environment=PINOLOKO_TOPE_PROPIO=92
Environment=PATH=/home/idarroniz/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
